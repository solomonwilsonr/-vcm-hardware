{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vcm.example.com/schemas/vcm-impact-1.json",
  "title": "VCM impact report (vcm-impact/1)",
  "description": "Output of `vcm impact --json` and GET /api/impact. Fields may be added within vcm-impact/1; removing or changing the meaning of a field requires vcm-impact/2. Consumers should ignore fields they do not know.",
  "type": "object",
  "required": ["schema", "from", "to", "provider", "summary", "catalog", "rules", "findings", "required_retests", "diff_summary"],
  "properties": {
    "schema": {"const": "vcm-impact/1"},
    "from": {"$ref": "#/$defs/sha256"},
    "to": {"$ref": "#/$defs/sha256"},
    "provider": {"type": "string", "description": "LLM provider name; 'none' means fully offline"},
    "summary": {
      "type": "object",
      "required": ["by_class", "by_severity", "changed_components", "catalog_coverage"],
      "properties": {
        "by_class": {
          "type": "object",
          "required": ["verified", "rule_based", "speculative"],
          "properties": {
            "verified": {"type": "integer", "minimum": 0},
            "rule_based": {"type": "integer", "minimum": 0},
            "speculative": {"type": "integer", "minimum": 0}
          }
        },
        "by_severity": {
          "type": "object",
          "required": ["critical", "warning", "info"],
          "properties": {
            "critical": {"type": "integer", "minimum": 0},
            "warning": {"type": "integer", "minimum": 0},
            "info": {"type": "integer", "minimum": 0}
          }
        },
        "changed_components": {"type": "array", "items": {"type": "string"}},
        "catalog_coverage": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "catalog": {
      "type": "object",
      "required": ["known", "unknown", "considered", "parts", "reviewed"],
      "properties": {
        "known": {"type": "array", "items": {"type": "string"}},
        "unknown": {"type": "array", "items": {"type": "string"}},
        "considered": {"type": "integer", "minimum": 0},
        "parts": {"type": "integer", "minimum": 0},
        "reviewed": {"type": "integer", "minimum": 0}
      }
    },
    "rules": {
      "type": "object",
      "required": ["domain", "plugins"],
      "properties": {
        "domain": {"enum": ["node", "board"]},
        "plugins": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "status", "findings"],
            "properties": {
              "name": {"type": "string"},
              "status": {"enum": ["ok", "error"]},
              "findings": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "required_retests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "confidence_class", "reason", "evidence"],
        "properties": {
          "name": {"type": "string"},
          "confidence_class": {"$ref": "#/$defs/confidence"},
          "reason": {"type": "string"},
          "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
        }
      }
    },
    "diff_summary": {"type": "object"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "confidence": {"enum": ["verified", "rule_based", "speculative"]},
    "finding": {
      "type": "object",
      "required": ["id", "confidence_class", "severity", "title", "detail", "refs", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[VRS][0-9]{3,}$"},
        "confidence_class": {"$ref": "#/$defs/confidence"},
        "severity": {"enum": ["critical", "warning", "info"]},
        "title": {"type": "string", "minLength": 1},
        "detail": {"type": "string"},
        "refs": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "derived_from": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["file", "commit", "ref", "db", "declared", "evidence", "plugin"]}
      }
    }
  }
}
