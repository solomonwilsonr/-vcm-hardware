# Appwrite credentials. These make the unit/rack registry the shared fleet of record
# (TablesDB) and enable semantic part search (VectorsDB). Without them VCM keeps everything
# in the checkout, which is fine for one engineer and is how the tests run.
# Copy to .env (gitignored) and fill in. Never put real values in THIS file:
# .env.example is committed, .env is not.
#
#   cp .env.example .env
#   vcm fleet health      # confirm the connection
#   vcm fleet provision   # create the unit/rack tables
#   vcm catalog provision # create the vector collection for part search
#   vcm graph provision   # optional: the shared dependency graph

# Region-specific. Find it in the Appwrite console; it looks like:
#   https://fra.cloud.appwrite.io/v1   (or nyc, syd, ... depending on your project's region)
VCM_APPWRITE_ENDPOINT=

# Project settings page in the console.
VCM_APPWRITE_PROJECT=

# API Keys -> Create API key. Required scopes:
#   databases.read  databases.write
#   tables.read     tables.write
#   columns.read    columns.write
#   indexes.read    indexes.write
#   rows.read       rows.write
# And, for semantic part search on VectorsDB (`vcm catalog ...`), also:
#   embeddings.write
#   vectors.read    vectors.write
# A key missing these still runs everything else; the part-search commands say which to add.
#
# Note: `provision` does not create the database when one already exists, because a project at
# its plan's database limit returns the same 403 as a permissions failure.
VCM_APPWRITE_API_KEY=

# Database id VCM creates and uses. Any value; "vcm" is fine. The graph tables, the fleet
# tables and the vector collection all live in it.
VCM_APPWRITE_DATABASE=vcm

# Set to 1 to keep units and racks in this checkout even when the variables above are set.
# The test suite sets this so a developer's real project is never touched by a test run.
#VCM_FLEET_LOCAL=1
